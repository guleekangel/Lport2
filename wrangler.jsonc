{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furniture-portfolio",
  "compatibility_date": "2026-11-26",

  // One self-contained index.html — no build step, no framework.
  // Only ./public is uploaded, so docs and config never appear publicly.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
